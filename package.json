{
  "name": "modalis",
  "private": true,
  "version": "0.1.0",
  "description": "Goal-based wealth management, programmed on Monad.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "verify": "bash scripts/verify.sh",
    "demo": "bash scripts/demo-local.sh",
    "dev": "node scripts/web.mjs dev",
    "build": "node scripts/web.mjs build",
    "start": "node scripts/web.mjs start",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "contracts:deploy:local": "cd contracts && forge script script/Deploy.s.sol:Deploy --rpc-url http://127.0.0.1:8545 --broadcast",
    "contracts:deploy:testnet": "cd contracts && forge script script/Deploy.s.sol:Deploy --rpc-url monad_testnet --broadcast",
    "contracts:sync-abis": "pnpm --filter @modalis/chain sync-abis",
    "test": "pnpm -r --filter './packages/*' --filter @modalis/web test",
    "typecheck": "pnpm -r --no-sort typecheck",
    "risk-monitor": "pnpm --filter @modalis/risk-monitor start",
    "risk-monitor:once": "pnpm --filter @modalis/risk-monitor once",
    "loop": "pnpm --filter @modalis/demo loop",
    "prices": "pnpm --filter @modalis/demo prices",
    "agent:create": "node --experimental-strip-types packages/chain/scripts/create-agent-wallet.ts",
    "envio:validate": "cd integrations/envio && python3 scripts/validate-config.py",
    "envio:codegen": "cd integrations/envio && pnpm install && pnpm codegen",
    "envio:dev": "cd integrations/envio && pnpm dev",
    "cre:simulate": "pnpm --filter @modalis/cre-risk-monitor simulate",
    "db:migrate": "for f in supabase/migrations/*.sql; do psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done",
    "db:local": "bash supabase/scripts/db-local.sh up",
    "db:check": "bash supabase/scripts/db-local.sh check",
    "db:down": "bash supabase/scripts/db-local.sh down",
    "db:integration": "bash scripts/db-integration.sh",
    "db:types": "pnpm --filter @modalis/db gen-types",
    "test:e2e": "pnpm --filter @modalis/web test:e2e"
  }
}
