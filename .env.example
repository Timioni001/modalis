# =====================================================================================
# MODALIS — environment variables
# Copy to `.env.local` (web) / `.env` (services, contracts). NEVER commit real values.
# Keep TESTNET and MAINNET in separate files: .env.testnet / .env.mainnet. Load one at a time.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser — never put a secret there.
#
# Chain IDs: Monad mainnet = 143, Monad testnet = 10143.
# Verify RPC URLs, explorer URLs and the CRE forwarder against current official docs before deploy.
# =====================================================================================

# ------------------------------------------------------------------ 1. NETWORK
MODALIS_NETWORK=testnet                          # testnet | mainnet
NEXT_PUBLIC_MONAD_CHAIN_ID=10143                 # 143 for mainnet
NEXT_PUBLIC_MONAD_NETWORK_NAME="Monad Testnet"
NEXT_PUBLIC_MONAD_EXPLORER_URL=                  # block explorer base URL (tx links in the UI)

# ------------------------------------------------------------------ 2. ALCHEMY (RPC + WebSockets)
# Create an app for Monad at https://dashboard.alchemy.com — YOU PROVIDE
NEXT_PUBLIC_ALCHEMY_API_KEY=
MONAD_TESTNET_RPC_URL=                           # e.g. https://monad-testnet.g.alchemy.com/v2/<key>
MONAD_MAINNET_RPC_URL=                           # e.g. https://monad-mainnet.g.alchemy.com/v2/<key>
MONAD_TESTNET_WS_URL=                            # wss:// endpoint for event streaming
MONAD_MAINNET_WS_URL=
NEXT_PUBLIC_MONAD_RPC_URL=                       # the ACTIVE network's RPC the browser should use

# ------------------------------------------------------------------ 3. DYNAMIC (embedded wallets)
# https://app.dynamic.xyz -> Developers -> SDK & API Keys — YOU PROVIDE
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=              # public; safe in browser
DYNAMIC_API_TOKEN=                               # SERVER ONLY — used to verify users / fetch wallets
DYNAMIC_JWKS_URL=                                # from Dynamic dashboard; used to verify JWTs server-side

# ------------------------------------------------------------------ 4. SUPABASE
# Project Settings -> API — YOU PROVIDE
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=                   # public; protected by RLS
SUPABASE_SERVICE_ROLE_KEY=                       # SERVER ONLY; bypasses RLS. Never expose.
SUPABASE_DB_URL=                                 # postgres:// connection string (migrations / indexer jobs)
# Optional waitlist alternative: set WAITLIST_PROVIDER=resend to use Resend Contacts instead of
# the Supabase waitlist table. This key is server-only.
WAITLIST_PROVIDER=supabase
RESEND_API_KEY=                                  # https://resend.com/api-keys

# ------------------------------------------------------------------ 5. CONTRACT ADDRESSES (filled AFTER deploy)
# Printed by `forge script script/Deploy.s.sol`. Public — addresses are not secrets.
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS=
NEXT_PUBLIC_PORTFOLIO_MANDATE_ADDRESS=
NEXT_PUBLIC_PORTFOLIO_VAULT_ADDRESS=
NEXT_PUBLIC_REBALANCE_EXECUTOR_ADDRESS=
NEXT_PUBLIC_RISK_SIGNAL_RECEIVER_ADDRESS=
NEXT_PUBLIC_PRICE_ORACLE_ADDRESS=                # demo MockPriceOracle (testnet only)
NEXT_PUBLIC_EXECUTION_ADAPTER_ADDRESS=           # MockExecutionAdapter now, KuruAdapter later
# Demo tokens (testnet only)
NEXT_PUBLIC_MUSD_ADDRESS=
NEXT_PUBLIC_MBTC_ADDRESS=
NEXT_PUBLIC_METH_ADDRESS=
NEXT_PUBLIC_MBOND_ADDRESS=

# ------------------------------------------------------------------ 6. KEYS / SIGNERS (SERVER ONLY — all secrets)
# Use a FRESH testnet-only key for each. Never reuse a key that holds real funds.
DEPLOYER_PRIVATE_KEY=                            # deploys contracts; owner of registry/vault/executor
                                                 #   (mainnet: transfer ownership to a multisig via Ownable2Step)
MANAGER_PRIVATE_KEY=                             # backend "manager": may ONLY submit rebalance proposals.
                                                 #   It has no withdrawal or mandate authority by design.
MANAGER_ADDRESS=                                 # public address of the manager key (users authorise this)
ORACLE_UPDATER_PRIVATE_KEY=                      # demo only: pushes MockPriceOracle prices (scenario engine)

# ------------------------------------------------------------------ 7. KURU (execution venue)
# See https://github.com/Kuru-Labs/kuru-sdk — YOU PROVIDE after reading current SDK docs
KURU_API_URL=
KURU_WS_URL=
KURU_MARKET_ADDRESSES=                           # comma-separated market contract addresses used by the adapter
KURU_ROUTER_ADDRESS=                             # if routing through Kuru's router contract

# ------------------------------------------------------------------ 8. CHAINLINK CRE (risk-monitor workflow)
# https://docs.chain.link/cre — install the CRE CLI (>= v1.29.0 for Monad) and `cre login`
CRE_ETH_PRIVATE_KEY=                             # key the CRE CLI uses to simulate/deploy + pay for writes
CRE_TARGET=staging-settings                      # CRE target name from your workflow's project.yaml
CRE_FORWARDER_ADDRESS=                           # CRE forwarder for the target Monad network (consumed by Deploy.s.sol)
CHAINLINK_CRE_API_URL=
CHAINLINK_CRE_WORKFLOW_ID=

# ------------------------------------------------------------------ 9. ENVIO (HyperIndex)
# https://envio.dev — hosted deployment token — YOU PROVIDE
ENVIO_API_TOKEN=
ENVIO_GRAPHQL_URL=                               # hosted GraphQL endpoint after deploying the indexer
ENVIO_START_BLOCK=                               # block of the first contract deployment (speeds up sync)

# ------------------------------------------------------------------ 10. AI (structured LLM layer)
AI_PROVIDER=anthropic
AI_API_KEY=                                      # SERVER ONLY
AI_MODEL=                                        # model id for goal interpretation / allocation / explanations

# ------------------------------------------------------------------ 11. APP / RISK MONITOR
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PORT=4000
RISK_MONITOR_INTERVAL_SECONDS=60                 # how often the off-CRE monitor polls (CRE has its own cron)
DEMO_MODE=true                                   # enables scenario engine (controlled price moves). Must be false on mainnet.
CRON_SECRET=                                     # private bearer secret for the Vercel daily testnet price-maintenance job

# ------------------------------------------------------------------ 12. OPTIONAL
PERPL_API_URL=                                   # only if the capped tactical sleeve is actually built
