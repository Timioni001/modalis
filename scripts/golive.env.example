# MODALIS — go-live settings. Copy this file to .env.golive at the repository root and fill it in:
#
#   cp scripts/golive.env.example .env.golive
#   nano .env.golive
#
# .env.golive is git-ignored. Never commit it, never paste it into a chat.

# --- Monad testnet ---------------------------------------------------------------------------
# A key made ONLY for testnet:  cast wallet new   then fund its address at https://faucet.monad.xyz
DEPLOYER_PRIVATE_KEY=
# Optional. Your own RPC endpoint. Leave empty to use https://testnet-rpc.monad.xyz
MONAD_TESTNET_RPC_URL=
# Optional. Your wallet address (from Settings -> Your account) to receive demo tokens.
FUND_WALLET=

# --- Supabase --------------------------------------------------------------------------------
# Project -> Connect -> "Session pooler" connection string (IPv4; works from WSL).
# It looks like: postgresql://postgres.abcdefgh:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
# Project Settings -> API: the project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API Keys -> "Legacy API keys" tab: anon and service_role
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional waitlist alternative. Set WAITLIST_PROVIDER=resend and add a server-only Resend key.
WAITLIST_PROVIDER=supabase
RESEND_API_KEY=

# --- Dynamic (wallet sign-in) ----------------------------------------------------------------
# app.dynamic.xyz -> Developers -> SDK & API Keys -> Environment ID
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# --- Optional --------------------------------------------------------------------------------
# A separate testnet key Modalis uses to carry out adjustments people approve. Leave empty and
# Modalis only recommends.
MANAGER_PRIVATE_KEY=
# Recommended. Run "Do it for me" from a Dynamic server wallet instead of MANAGER_PRIVATE_KEY.
# DYNAMIC_API_TOKEN: app.dynamic.xyz -> Developers -> API tokens (needs server wallets enabled).
# Then `pnpm agent:create` prints DYNAMIC_AGENT_WALLET (secret) and the address to fund with MON.
# DYNAMIC_AGENT_PASSWORD is optional and must match the one used with agent:create.
# See docs/dynamic.md. When these are set they win over MANAGER_PRIVATE_KEY.
DYNAMIC_API_TOKEN=
DYNAMIC_AGENT_WALLET=
DYNAMIC_AGENT_PASSWORD=
# A separate testnet key that pays for "Get test money": it mints demo tokens to new users and
# tops up 0.05 MON when their wallet has none, so they can start without a faucet. Make it with
# `cast wallet new` and fund it at https://faucet.monad.xyz. Leave empty and users mint the demo
# tokens from their own wallet, with a link to the faucet when they have no MON.
FAUCET_PRIVATE_KEY=
# Optional, testnet only. A separate key that turns on the live demo buttons ("Simulate a market
# move", "Test my rules") and signs `bash scripts/move-prices.sh`. go-live hands the demo price
# oracle to it, so the deployer key never goes to Vercel. Make it with `cast wallet new`.
ORACLE_UPDATER_PRIVATE_KEY=
# Optional. An Anthropic API key so typed goals ("a house in 5 years") are understood. AI_MODEL
# defaults to the model set in packages/ai.
AI_API_KEY=
AI_MODEL=
# Optional. Use an OpenAI-compatible provider instead of Anthropic (Kimi, Qwen, OpenRouter...):
# its base URL, e.g. https://api.moonshot.ai/v1, with that provider's key in AI_API_KEY and its
# model name in AI_MODEL (required then).
AI_BASE_URL=
# Optional. Your hosted Envio indexer's GraphQL URL, for instant activity history.
ENVIO_GRAPHQL_URL=
# Optional. A Sentry project's DSN (sentry.io -> Project settings -> Client Keys). Unhandled
# server errors are then reported there, with secrets scrubbed. Leave empty for logs only.
SENTRY_DSN=
# Optional, used by `bash scripts/add-integrations.sh` to add to the existing deployment.
# The values below were verified to have contract code on Monad testnet on 2026-10-12; uncomment
# to use them, and re-check before a demo. Full notes in docs/integrations.md.
#
# Chainlink CRE: the PRODUCTION KeystoneForwarder for monad-testnet. (The mock forwarder,
# 0xB9F79d863261869B234c481D1f9A7af84AeAd192, is only for `cre workflow simulate`.)
# Confirm it for your own tenant with `cre workflow supported-chains`.
#CRE_FORWARDER_ADDRESS=0xF8344CFd5c43616a4366C34E3EEE75af79a74482
CRE_FORWARDER_ADDRESS=
# Kuru's router on Monad testnet, and its MON-USDC market.
#KURU_ROUTER_ADDRESS=0x7EFbE105Ca7415dE98F96622173458ac1c054630
#KURU_MARKET_ADDRESSES=0xa241896A7Dbe8a550D2E5fF7A914bB1989ceD2D9
KURU_ROUTER_ADDRESS=
KURU_MARKET_ADDRESSES=
# Leave KURU_API_URL UNSET on testnet. Setting it routes real trades to Kuru, but the demo tokens
# have no Kuru market and Kuru's API is mainnet-only. The adapter still deploys and is approved as
# a venue, which is the part that is real on testnet.
# Your production URL, e.g. https://modalis-six.vercel.app (used for the final health check)
SITE_URL=
